{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "anubis",
      "camelcase": "Anubis",
      "title": "Anubis",
      "scope": "source.anubis",
      "file-types": [ "anubis" ],
      "injection-regex": "^anubis$",
      "class-name": "TreeSitterAnubis",
      "highlights": ["queries/highlights.scm"],
      "injections": ["queries/injections.scm"]
    },
    {
      "name": "maml",
      "camelcase": "Maml",
      "title": "MAML",
      "scope": "text.maml",
      "path": "maml",
      "file-types": [ "maml" ],
      "injection-regex": "^maml$",
      "highlights": ["maml/queries/highlights.scm"],
      "injections": [],
      "locals": [],
      "tags": []
    },
    {
      "name": "apg2",
      "camelcase": "Apg2",
      "title": "APG2",
      "scope": "source.apg2",
      "path": "apg2",
      "file-types": [ "apg2" ],
      "injection-regex": "^apg2$",
      "highlights": ["apg2/queries/highlights.scm"],
      "injections": ["apg2/queries/injections.scm"],
      "locals": [],
      "tags": []
    },
    {
      "name": "oplang",
      "camelcase": "Oplang",
      "title": "OpLang",
      "scope": "source.oplang",
      "path": "oplang",
      "file-types": [ "oplang" ],
      "injection-regex": "^oplang$",
      "highlights": ["oplang/queries/highlights.scm"],
      "injections": ["oplang/queries/injections.scm"],
      "locals": [],
      "tags": []
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Anubis grammar for tree-sitter",
    "authors": [
      {
        "name": "HerrmannM",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/HerrmannM/tree-sitter-anubis",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
