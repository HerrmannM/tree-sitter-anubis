    },
    "host_type": {
      "type": "PATTERN",
      "value": "-[A-Z][A-Za-z0-9_]*"
    },
    "defined_name": {
      "type": "PATTERN",
      "value": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+(\\.[0-9]+)?"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\\\\\n]|\\\\.)*\""
    },
    "line_comment": {
      "type": "PATTERN",
      "value": "\\/\\/[^\\n]*"
    },
    "_space": {
      "type": "PATTERN",
      "value": "[ \\t\\r]+"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\n([ \\t\\r]*\\n)*[ \\t\\r]+"
    },
    "_other": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\sA-Za-z0-9_()\\[\\]:,\\/@\"\\-.]+"
        },
        {
          "type": "PATTERN",
          "value": "\\.[^\\s]"
        },
        {
          "type": "PATTERN",
          "value": "_[A-Za-z0-9_]*"
        },
        {
          "type": "STRING",
          "value": "@"
